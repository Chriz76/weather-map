{
  "compilerOptions": {
    "target": "ES6",
    "checkJs": true,
    "allowJs": true,
    "module": "ES6",
    "moduleResolution": "node",
    "strict": true,
    "noImplicitAny": true,
    "alwaysStrict": true,
    "ignoreDeprecations": "6.0"
  },
    "typeAcquisition": {
      "enable": true
    },
  "include": [
    "js/**/*",
    "leaflet.d.ts"
  ],
  "exclude": [
    "tests"
  ]
}